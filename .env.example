# SEC EDGAR Fair-Access Policy requires a descriptive User-Agent: "AppName ContactEmail"
SEC_USER_AGENT="AutonomousSECAnalyst/0.1 (contact@example.com)"
SEC_RATE_LIMIT_RPS=8.0
SEC_CACHE_DIR="data/raw_sec"

# PostgreSQL + pgvector
DATABASE_URL="postgresql://sec_analyst:sec_analyst@localhost:5432/sec_analyst"
DATABASE_READONLY_URL="postgresql://sec_readonly:sec_readonly@localhost:5432/sec_analyst"

# Local LLM & Embeddings (RTX 3090)
LLM_BASE_URL="http://localhost:8080/v1"
LLM_MODEL="Qwen3-8B-Q4_K_M"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=1024
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
